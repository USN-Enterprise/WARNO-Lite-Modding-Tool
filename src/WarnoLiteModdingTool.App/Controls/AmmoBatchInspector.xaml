<UserControl x:Class="WarnoLiteModdingTool.App.Controls.AmmoBatchInspector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:WarnoLiteModdingTool.App.Localisation" xmlns:controls="clr-namespace:WarnoLiteModdingTool.App.Controls">
 <UserControl.Resources>
  <DataTemplate x:Key="OptionLabel"><TextBlock Text="{l:LocalizedBinding Path=Label}"/></DataTemplate>
  <DataTemplate x:Key="StringLabel"><TextBlock Text="{l:LocalizedBinding Path=.}"/></DataTemplate>
 </UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="{l:Loc Key='批量弹药检查器'}" FontSize="18" FontWeight="SemiBold"/>
   <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,8,0,10">
    <TextBlock Text="{Binding BatchTargetText}" TextWrapping="Wrap"/>
   </Border>
   <WrapPanel IsEnabled="{Binding CanEditBatch}">
    <TextBlock Text="{l:Loc Key='目标范围'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox ItemsSource="{Binding BatchScopes}" SelectedItem="{Binding BatchScope}" ItemTemplate="{StaticResource StringLabel}" MinWidth="160"/>
   </WrapPanel>
   <TextBlock Text="{l:LocalizedBinding Path=BatchEmptyText}" TextWrapping="Wrap" Margin="0,6,0,4"/>
  </StackPanel>
  <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0">
   <Button Content="{l:Loc Key='预览并应用全部'}" Style="{StaticResource PrimaryButton}" Click="Apply_Click" Padding="12,7" IsEnabled="{Binding DataContext.UnitWorkspace.CanApply, RelativeSource={RelativeSource AncestorType=Window}}"/>
  </WrapPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Expander Header="{l:Loc Key='公式调整'}" IsExpanded="True" Margin="0,0,0,12">
     <StackPanel Margin="0,8,0,0">
      <WrapPanel IsEnabled="{Binding CanEditBatch}">
       <StackPanel Width="240" Margin="0,0,10,8"><TextBlock Text="{l:Loc Key='参数'}" Margin="0,0,0,3"/>
        <ComboBox Tag="ammo-batch-field" ItemsSource="{Binding CommonBatchFields}" SelectedItem="{Binding BatchField}" ItemTemplate="{StaticResource OptionLabel}"/>
       </StackPanel>
       <StackPanel Width="175" Margin="0,0,10,8"><TextBlock Text="{l:Loc Key='运算'}" Margin="0,0,0,3"/>
        <ComboBox Tag="ammo-batch-operation" ItemsSource="{Binding BatchOperations}" SelectedItem="{Binding BatchOperation}" ItemTemplate="{StaticResource OptionLabel}"/>
       </StackPanel>
       <StackPanel Width="145" Margin="0,0,10,8"><TextBlock Text="{l:Loc Key='数值'}" Margin="0,0,0,3"/>
        <Grid>
         <TextBox Tag="ammo-batch-operand" Text="{Binding BatchOperand, UpdateSourceTrigger=PropertyChanged}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding BatchNumeric}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
         <ComboBox ItemsSource="{Binding BatchChoices}" SelectedItem="{Binding BatchOperand}" ItemTemplate="{StaticResource StringLabel}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding BatchNumeric}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
        </Grid>
       </StackPanel>
       <StackPanel Width="135" Margin="0,0,10,8" Visibility="{Binding BatchNumeric, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{l:Loc Key='取整'}" Margin="0,0,0,3"/><ComboBox ItemsSource="{Binding BatchRoundings}" SelectedItem="{Binding BatchRounding}" ItemTemplate="{StaticResource OptionLabel}"/></StackPanel>
      </WrapPanel>
      <WrapPanel IsEnabled="{Binding CanEditBatch}" Visibility="{Binding DataContext.AdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
       <TextBlock Text="{l:Loc Key='最小值'}" VerticalAlignment="Center"/><TextBox Width="95" Text="{Binding BatchMinimum, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,16,8" IsEnabled="{Binding BatchNumeric}"/>
       <TextBlock Text="{l:Loc Key='最大值'}" VerticalAlignment="Center"/><TextBox Width="95" Text="{Binding BatchMaximum, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,8" IsEnabled="{Binding BatchNumeric}"/>
      </WrapPanel>
      <controls:ParameterNote Text="{Binding BatchField.Parameter}" Margin="0,0,0,6"/>
      <TextBlock Text="{l:LocalizedBinding Path=BatchField.Hint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,8"/>
      <WrapPanel>
       <Button Content="{l:Loc Key='预览批量结果'}" Tag="ammo-batch-preview" Style="{StaticResource SecondaryButton}" Click="Preview_Click" IsEnabled="{Binding CanCalculateBatch}" Padding="10,6" Margin="0,0,8,0"/>
       <Button Content="{l:Loc Key='加入草稿'}" Tag="ammo-batch-save" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="{Binding CanCalculateBatch}" Padding="12,7"/>
      </WrapPanel>
     </StackPanel>
    </Expander>
    <TextBlock Text="{l:LocalizedBinding Path=BatchMessage}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding BatchSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Expander Header="{l:Loc Key='全部结果'}" IsExpanded="True" Margin="0,0,0,10">
     <DataGrid ItemsSource="{Binding BatchRows}" Tag="ammo-batch-results" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="260" EnableRowVirtualization="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="{l:Loc Key='弹药'}" Binding="{Binding DisplayName}" Width="*" MinWidth="110"/>
       <DataGridTextColumn Header="{l:Loc Key='内部名'}" Binding="{Binding Name}" Width="*" MinWidth="110"/>
       <DataGridTextColumn Header="{l:Loc Key='当前值'}" Binding="{Binding Current}" Width="85"/>
       <DataGridTextColumn Header="{l:Loc Key='目标值'}" Binding="{Binding Target}" Width="85"/>
       <DataGridTextColumn Header="{l:Loc Key='状态'}" Binding="{l:LocalizedBinding Path=Status}" Width="*" MinWidth="100"/>
      </DataGrid.Columns>
     </DataGrid>
    </Expander>
    <Expander Header="{l:Loc Key='全部使用者'}" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="{Binding BatchImpactText}" Margin="0,6,0,6"/>
      <TextBox Text="{Binding BatchImpactSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc Key='搜索弹药、武器或单位'}" Margin="0,0,0,6"/>
      <DataGrid ItemsSource="{Binding BatchReferences}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="240" EnableRowVirtualization="True">
       <DataGrid.Columns><DataGridTextColumn Header="Ammo" Binding="{Binding Ammo}" Width="*"/><DataGridTextColumn Header="Weapon" Binding="{Binding Weapon}" Width="*"/><DataGridTextColumn Header="{l:Loc Key='单位'}" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="{l:Loc Key='内部名'}" Binding="{Binding Unit}" Width="*"/></DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Expander>
    <TextBlock Text="{l:Loc Key='共有字段'}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock Text="{l:Loc Key='只显示目标弹药共有的可编辑字段；多种值留空，加入草稿后才保存。'}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
    <ItemsControl ItemsSource="{Binding CommonBatchFieldsView}" IsEnabled="{Binding CanEditBatch}">
     <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{l:LocalizedBinding Path=Name}" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,8">
       <StackPanel>
        <controls:FieldRow Header="{l:LocalizedBinding Path=Label}" Parameter="{Binding Parameter}">
         <StackPanel>
          <TextBlock Text="{l:Loc Key='多种值'}" Visibility="{Binding IsMixed, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
          <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsNumeric, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding EditValue}" ItemTemplate="{StaticResource StringLabel}" Visibility="{Binding IsChoice, Converter={StaticResource BooleanToVisibilityConverter}}"/>
         </StackPanel>
        </controls:FieldRow>
        <TextBlock Text="{l:LocalizedBinding Path=Error}" TextWrapping="Wrap" Margin="0,4,0,4"/>
        <Button Content="{l:Loc Key='加入草稿'}" Tag="ammo-common-save" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="8,4" IsEnabled="{Binding CanAdd}" Click="CommonSave_Click"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>
