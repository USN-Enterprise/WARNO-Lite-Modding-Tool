<UserControl x:Class="WarnoLiteModdingTool.App.Workspaces.ProblemWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:WarnoLiteModdingTool.App.Localisation"
    xmlns:controls="clr-namespace:WarnoLiteModdingTool.App.Controls">
<Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="430" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="390" MinWidth="320" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0"><TextBlock DockPanel.Dock="Top" Text="{l:Loc Key='报错系统尚不完善，可能存在误报。如未进行相关操作，请忽略该提示。'}" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="{l:Loc Key=全选}" Tag="all" Click="ProblemAction_Click"/><Button Content="{l:Loc Key=取消全选}" Tag="none" Click="ProblemAction_Click"/><Button Content="{l:Loc Key=忽略所选问题}" Tag="ignore" Click="ProblemAction_Click"/><Button Content="{l:Loc Key=恢复所选问题}" Tag="restore" Click="ProblemAction_Click"/></StackPanel><TabControl x:Name="ProblemTabs">
                            <TabItem>
                                <TabItem.Header><TextBlock><Run Text="{l:Loc Key='Mod 问题（'}" /><Run Text="{Binding ModProblemCount, Mode=OneWay}" /><Run Text="）" /></TextBlock></TabItem.Header>
                                <ListBox SelectionMode="Extended" x:Name="ModProblemList" ItemsSource="{Binding ModProblems}" SelectedItem="{Binding SelectedProblem}" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,9">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{l:LocalizedBinding Path=Title}" FontWeight="SemiBold" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SeverityText}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="10" />
                                                    </DockPanel>
                                                    <TextBlock Text="{l:LocalizedBinding Path=Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header><TextBlock><Run Text="{l:Loc Key='工具问题（'}" /><Run Text="{Binding ToolProblemCount, Mode=OneWay}" /><Run Text="）" /></TextBlock></TabItem.Header>
                                <ListBox SelectionMode="Extended" x:Name="ToolProblemList" ItemsSource="{Binding ToolProblems}" SelectedItem="{Binding SelectedProblem}" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,9">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{l:LocalizedBinding Path=Title}" FontWeight="SemiBold" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SeverityText}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="10" />
                                                    </DockPanel>
                                                    <TextBlock Text="{l:LocalizedBinding Path=Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        <TabItem Header="{l:Loc Key=已忽略}"><ListBox x:Name="IgnoredProblemList" SelectionMode="Extended" ItemsSource="{Binding IgnoredProblems}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedProblem}"/></TabItem></TabControl></DockPanel>

                        <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Key='诊断详情'}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedProblem.Title, TargetNullValue=请选择一条问题}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedProblem.Id, StringFormat=错误编号：{0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedProblem.Location, StringFormat=位置：{0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding SelectedProblem.DiagnosticText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="{l:Loc Key='复制诊断'}" Style="{StaticResource PrimaryButton}" Padding="12,7" Click="CopyProblem_Click" />
                                    <Button Content="{l:Loc Key='打开日志目录'}" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0" Click="OpenProblemLogs_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
</UserControl>
