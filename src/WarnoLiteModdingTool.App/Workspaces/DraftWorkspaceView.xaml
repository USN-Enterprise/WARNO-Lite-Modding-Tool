<UserControl x:Class="WarnoLiteModdingTool.App.Workspaces.DraftWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:WarnoLiteModdingTool.App.Localisation"
    xmlns:controls="clr-namespace:WarnoLiteModdingTool.App.Controls">
<Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DraftListColumn" Width="*" MinWidth="480" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition x:Name="DraftDetailColumn" Width="390" MinWidth="320" MaxWidth="620" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                                <StackPanel><TextBlock Text="{l:Loc Key=全部未应用草稿}" FontWeight="SemiBold"/><WrapPanel Margin="0,7,0,0"><Button Content="{l:Loc Key='全选'}" Click="SelectAllDrafts_Click"/><Button Content="{l:Loc Key='取消全选'}" Click="ClearDraftSelection_Click"/><Button Content="{l:Loc Key='应用选中项'}" Tag="selected" Click="PreviewApply_Click"/><Button Content="{l:Loc Key='删除选中项'}" Click="DeleteSelectedDrafts_Click"/></WrapPanel></StackPanel>
                            </Border>
                            <DataGrid x:Name="DraftOverviewGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding UnitWorkspace.DraftView}"
                                      SelectedItem="{Binding SelectedDraft}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      RowHeaderWidth="0"
                                      RowHeight="42">
                                <DataGrid.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander x:Name="BatchExpander" IsExpanded="False" Margin="0,4"><Expander.Header><StackPanel x:Name="BatchHeader" Orientation="Horizontal"><CheckBox IsThreeState="True" Click="DraftGroupSelect_Click" Loaded="DraftGroup_Loaded" Margin="0,0,8,0"/><TextBlock Text="{Binding Items[0].BatchSummary}" MaxWidth="540" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}"/></StackPanel></Expander.Header><ItemsPresenter/></Expander><ControlTemplate.Triggers><DataTrigger Binding="{Binding Items[0].Resolved.Operation.GroupId}" Value="{x:Null}"><Setter TargetName="BatchExpander" Property="IsExpanded" Value="True"/><Setter TargetName="BatchExpander" Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></DataGrid.GroupStyle>
                                <DataGrid.Columns><DataGridTemplateColumn Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="DraftSelection_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:Loc Key='修改内容'}" Binding="{l:LocalizedBinding Path=Summary}" ElementStyle="{StaticResource IndexPrimaryGridText}" HeaderStyle="{StaticResource IndexGridColumnHeader}" Width="3*" MinWidth="260" />
                                    <DataGridTextColumn Header="{l:Loc Key='模块'}" Binding="{l:LocalizedBinding Path=Module}" ElementStyle="{StaticResource SecondaryGridText}" Width="86" />
                                    <DataGridTextColumn Header="{l:Loc Key='状态'}" Binding="{Binding Status}" ElementStyle="{StaticResource SecondaryGridText}" Width="110" />
                                    <DataGridTextColumn Header="{l:Loc Key='源文件'}" Binding="{Binding File}" ElementStyle="{StaticResource SecondaryGridText}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <GridSplitter x:Name="DraftPaneSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" />

                        <Grid Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16">
                                    <TextBlock Text="{l:Loc Key='草稿详情'}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding SelectedDraft.Summary, TargetNullValue=请从左侧选择一项草稿}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding SelectedDraft.Status}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />

                                    <TextBlock Text="{l:Loc Key='修改值'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,18,0,6" />
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{l:LocalizedBinding Path=SelectedDraft.BaselineValue}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="↓" Foreground="{DynamicResource PrimaryBrush}" FontSize="14" Margin="0,3" />
                                            <TextBlock Text="{Binding SelectedDraft.TargetValue, TargetNullValue=—}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="{l:Loc Key='原始草稿'}" Visibility="{Binding AdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding SelectedDraft.RawValues}" TextWrapping="Wrap"/></Expander>
                                    <TextBlock Text="{l:Loc Key='归属'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,16,0,5" />
                                    <TextBlock Text="{Binding SelectedDraft.Module, StringFormat=模块：{0}}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedDraft.Scope, StringFormat=作用域：{0}}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedDraft.ObjectName, StringFormat=对象：{0}}" TextWrapping="Wrap" Margin="0,3,0,0" />

                                    <Expander Header="{l:Loc Key=内部位置}" Visibility="{Binding AdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,12,0,0"><StackPanel><TextBlock Text="{l:Loc Key='内部位置'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,16,0,5" />
                                    <TextBlock Text="{Binding SelectedDraft.ObjectType, StringFormat=类型：{0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedDraft.FieldPath, StringFormat=字段：{0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedDraft.File, StringFormat=文件：{0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedDraft.UpdatedText, StringFormat=更新时间：{0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel></Expander><Expander Margin="0,10,0,0" IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock Text="{l:Loc Key='事务备份与恢复'}" FontWeight="SemiBold" />
                                            </Expander.Header>
                                            <StackPanel Margin="0,9,0,0">
                                                <TextBlock Text="{l:Loc Key='存在未应用草稿时不能恢复；恢复前也会备份当前文件。'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding UnitWorkspace.Backups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,7">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="11" />
                                                                        <TextBlock Text="{Binding StateText}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding BackupId}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding FilesText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                    <DockPanel Margin="0,5,0,0">
                                                                        <Button Content="{l:Loc Key='恢复'}" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="8,3"
                                                                                IsEnabled="{Binding CanRestore}" Click="RestoreBackup_Click" />
                                                                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="9" TextWrapping="Wrap" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander></StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="{l:Loc Key='预览并应用全部'}" Style="{StaticResource PrimaryButton}" Padding="10,6" IsEnabled="{Binding UnitWorkspace.CanApply}" Click="PreviewApply_Click" />
                                    <Button Content="{l:Loc Key='清空全部草稿'}" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="7,0,0,0" IsEnabled="{Binding UnitWorkspace.CanClearDrafts}" Click="ClearDrafts_Click" />
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Grid>
</UserControl>
