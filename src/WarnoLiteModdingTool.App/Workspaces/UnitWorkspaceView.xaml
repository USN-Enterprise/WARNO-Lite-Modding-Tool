<UserControl x:Class="WarnoLiteModdingTool.App.Workspaces.UnitWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:WarnoLiteModdingTool.App.Localisation"
    xmlns:controls="clr-namespace:WarnoLiteModdingTool.App.Controls">
<Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid x:Name="UnitFilterPanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox x:Name="UnitSearchBox" Text="{Binding UnitWorkspace.TextFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc Key='搜索名称或内部描述符'}" Padding="29,6,9,6" />
                                    <TextBlock x:Name="UnitSearchIcon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>

                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                    <ItemsControl x:Name="UnitActiveFilterTags" ItemsSource="{Binding UnitWorkspace.ActiveFilterTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="13" Padding="9,4,4,4" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" FontSize="11" />
                                                        <Button Content="×" Style="{StaticResource SecondaryButton}" Padding="5,0" Margin="5,0,0,0" MinWidth="20" Click="RemoveFilterTag_Click" ToolTip="{l:Loc Key='移除此筛选'}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Grid.Column="3" Content="{l:Loc Key='清空'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="ClearUnitFilters_Click"
                                        Visibility="{Binding UnitWorkspace.HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <ToggleButton x:Name="UnitFilterButton" Grid.Column="5" MinWidth="92" MinHeight="36" Padding="16,9" IsChecked="{Binding UnitWorkspace.IsFilterPanelOpen, Mode=TwoWay}">
                                    <TextBlock>
                                        <Run Text="{l:Loc Key='筛选 '}" /><Run Text="{Binding UnitWorkspace.ActiveFilterCount, Mode=OneWay}" />
                                    </TextBlock>
                                </ToggleButton>

                                <Popup x:Name="UnitFilterPopup"
                                       PlacementTarget="{Binding ElementName=UnitFilterButton}"
                                       Placement="Bottom"
                                       HorizontalOffset="-690"
                                       VerticalOffset="5"
                                       AllowsTransparency="True"
                                       StaysOpen="False"
                                       IsOpen="{Binding UnitWorkspace.IsFilterPanelOpen, Mode=TwoWay}">
                                    <Border Width="790" MaxHeight="540" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{l:Loc Key='组合筛选'}" FontSize="16" FontWeight="SemiBold" />
                                                    <ComboBox DockPanel.Dock="Right" Width="112" ItemsSource="{Binding UnitWorkspace.FilterMatchModes}" SelectedItem="{Binding UnitWorkspace.FilterMatchMode}" ToolTip="{l:Loc Key='全部条件：跨类别都满足；任一条件：任一类别命中'}" />
                                                </DockPanel>
                                                <TextBlock Text="{l:Loc Key='同类标签始终任选其一；文本搜索始终与筛选结果相交。'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,-7,0,10" />
                                                <ItemsControl ItemsSource="{Binding UnitWorkspace.FilterDimensions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,13">
                                                                <TextBlock Text="{l:LocalizedBinding Path=Label}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                                <StackPanel Orientation="Horizontal"><Button Content="{l:Loc Key='全选'}" Tag="True" Click="SelectFilterDimension_Click"/><Button Content="{l:Loc Key='取消全选'}" Tag="False" Click="SelectFilterDimension_Click"/></StackPanel><ItemsControl ItemsSource="{Binding Options}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox Content="{l:GameBinding Path=Value, KindPath=DimensionKey}" Visibility="{l:GameBinding Path=Value, KindPath=DimensionKey, Visibility=True}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource FilterPillCheckBox}" Margin="0,0,7,6" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,11,0,0">
                                                    <DockPanel>
                                                        <Button Content="{l:Loc Key='清空全部'}" Style="{StaticResource SecondaryButton}" Padding="11,6" Click="ClearUnitFilters_Click" />
                                                        <Button Content="{l:Loc Key='收起'}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="CloseUnitFilters_Click" />
                                                    </DockPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button x:Name="UnitSelectAllButton" Content="{l:Loc Key='全选当前筛选'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="SelectVisibleBatch_Click" ToolTip="{l:Loc Key='把当前表格中的完整筛选结果加入勾选集合'}" />
                                        <Button x:Name="UnitClearSelectionButton" Content="{l:Loc Key='清空选择'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="8,0,0,0" Click="ClearBatchSelection_Click" />
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="{l:Loc Key='批量选择 · 已选 '}" /><Run Text="{Binding UnitWorkspace.BatchSelectedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{l:Loc Key=' 个'}" />
                                    </TextBlock>
                                </DockPanel>
                            <StackPanel Orientation="Horizontal"><ToggleButton Content="{l:Loc Key=批量编辑}" IsChecked="{Binding UnitWorkspace.IsBatchToolsOpen, Mode=TwoWay}" Margin="0,0,8,0"/><Button Content="{l:Loc Key=新增单位}" Click="CreateUnit_Click"/><Button Content="{l:Loc Key=编辑创建设置}" Tag="edit" Click="CreateUnit_Click"/></StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="UnitListColumn" Width="*" MinWidth="320" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition x:Name="UnitInspectorColumn" Width="1.35*" MinWidth="420" />

                            </Grid.ColumnDefinitions>

                            <DataGrid Grid.Column="0"
                                      ItemsSource="{Binding UnitWorkspace.UnitsView}"
                                      SelectedItem="{Binding UnitWorkspace.SelectedUnit}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                      BorderThickness="0"
                                      RowHeaderWidth="0"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{l:Loc Key='Unit 详情'}" IsEnabled="False" FontWeight="SemiBold" />
                                        <Separator />
                                        <MenuItem Header="{Binding UnitWorkspace.SelectedUnit.InternalName, StringFormat=内部名：{0}}" IsEnabled="False" />
                                        <MenuItem Header="{Binding UnitWorkspace.SelectedUnit.DivisionsText, StringFormat=师规则：{0}}" IsEnabled="False" />
                                        <MenuItem Header="{Binding UnitWorkspace.SelectedUnit.WeaponsText, StringFormat=Weapon：{0}}" IsEnabled="False" />
                                        <MenuItem Header="{Binding UnitWorkspace.SelectedUnit.AmmunitionText, StringFormat=Ammo：{0}}" IsEnabled="False" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{l:Loc Key='选'}" Width="42">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsBatchSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="{l:Loc Key='加入批量勾选范围'}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:Loc Key='名称'}" Binding="{Binding DisplayName}" ElementStyle="{StaticResource IndexPrimaryGridText}" HeaderStyle="{StaticResource IndexGridColumnHeader}" IsReadOnly="True" Width="2*" />
                                    <DataGridTextColumn Header="{l:Loc Key='国家'}" Binding="{l:GameBinding Path=Country, Kind=country}" IsReadOnly="True" Width="70" />
                                    <DataGridTextColumn Header="{l:Loc Key='栏位'}" Binding="{l:GameBinding Path=Factory, Kind=factory}" IsReadOnly="True" Width="1.1*" />
                                    <DataGridTextColumn Header="{l:Loc Key='角色'}" Binding="{l:GameBinding Path=Role, Kind=role}" IsReadOnly="True" Width="90" />
                                    <DataGridTextColumn Header="{l:Loc Key='草稿'}" Binding="{Binding DraftStatus}" IsReadOnly="True" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <GridSplitter x:Name="UnitPaneSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" />

                            <Border x:Name="SingleUnitInspector" Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}">
                                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding UnitWorkspace.HasBatchInspector}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16">
                                        <DockPanel LastChildFill="True"><controls:UnitPortrait DockPanel.Dock="Right" Unit="{Binding UnitWorkspace.SelectedUnit.Unit}" Root="{Binding UnitWorkspace.Data.Localisation.ProjectRoot}"/><StackPanel>
                                        <TextBlock Text="{l:Loc Key='单位检查器'}" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="{Binding UnitWorkspace.SelectedUnit.DisplayName, TargetNullValue=尚未选择单位}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        </StackPanel></DockPanel>
                                        <TextBlock Visibility="{Binding AdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding UnitWorkspace.SelectedUnit.InternalName}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,12" />

                                        <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10"
                                                Visibility="{Binding AdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{l:Loc Key='只读引用影响'}" FontWeight="SemiBold" FontSize="11" />
                                                <TextBlock Text="{Binding UnitWorkspace.SelectedUnit.DivisionsText, StringFormat=师规则：{0}}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding UnitWorkspace.SelectedUnit.WeaponsText, StringFormat=Weapon：{0}}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding UnitWorkspace.SelectedUnit.AmmunitionText, StringFormat=Ammo：{0}}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10"
                                                Visibility="{Binding UnitWorkspace.HasDraftLoadError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding UnitWorkspace.DraftLoadError}" TextWrapping="Wrap" />
                                        </Border>

                                        <ItemsControl x:Name="UnitFieldSections" ItemsSource="{Binding UnitWorkspace.FieldSections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,9">
                                                        <Expander.Header>
                                                            <DockPanel MinWidth="240">
                                                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center">
                                                                    <Run Text="{Binding FieldCount, Mode=OneWay}" /><Run Text="{l:Loc Key=' 项'}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{l:LocalizedBinding Path=Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,0,0,8">
                                                                        <TextBlock Text="{l:LocalizedBinding Path=Title}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,5" />
                                                                        <ItemsControl ItemsSource="{Binding Fields}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,8" ToolTip="{l:LocalizedBinding Path=Hint}">
                                                                                        <StackPanel><controls:FieldRow Header="{l:LocalizedBinding Path=DisplayLabel}" Parameter="{Binding OriginalParameter}"><StackPanel><Grid>
                                                                                                <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" Visibility="{Binding IsTextEditor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" Padding="8,6" Visibility="{Binding IsChoiceEditor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                                <StackPanel Visibility="{Binding IsDeploymentEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                    <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" ToolTip="{l:Loc Key='可直接填写任意非负有限部署距离'}" />
                                                                                                    <ComboBox ItemsSource="{Binding DeploymentPresets}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedIndex="-1"
                                                                                                              IsEnabled="{Binding IsEditable}" Padding="8,6" Margin="0,6,0,0"
                                                                                                              SelectionChanged="DeploymentPreset_SelectionChanged" ToolTip="{l:Loc Key='选择当前 Mod 中已有的前置部署档位作为参考'}" />
                                                                                                </StackPanel>
                                                                                                <StackPanel Visibility="{Binding IsPillEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                    <TextBlock FontSize="10" Margin="0,0,0,4"><Run Text="{l:Loc Key=已选}"/><Run Text=" "/><Run Text="{Binding SelectedChoiceCount, Mode=OneWay}"/></TextBlock><ItemsControl ItemsSource="{Binding SelectedChoices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5,2" Margin="0,0,4,4"><StackPanel Orientation="Horizontal"><TextBlock Text="{l:GameBinding Path=Display, KindPath=Kind}" VerticalAlignment="Center"/><Button Content="×" Padding="3,0" IsEnabled="{Binding IsEnabled}" Click="RemoveUnitChoice_Click"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                                                                    <ToggleButton x:Name="FieldChoiceButton" Content="{l:Loc Key='选择标签'}" IsEnabled="{Binding IsEditable}" Padding="10,6" />
                                                                                                    <Popup PlacementTarget="{Binding ElementName=FieldChoiceButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=FieldChoiceButton, Mode=TwoWay}">
                                                                                                        <Border Width="420" MaxHeight="360" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
                                                                                                            <DockPanel><StackPanel DockPanel.Dock="Top"><TextBox Text="{Binding ChoiceSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="{l:Loc Key=搜索标签}"/>
                                                                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMultiChoiceEditor, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="{l:Loc Key='全选'}" Tag="True" Click="SelectFieldChoices_Click"/><Button Content="{l:Loc Key='取消全选'}" Tag="False" Click="SelectFieldChoices_Click"/></StackPanel></StackPanel><ListBox Height="250" ItemsSource="{Binding ChoicesView}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">

                                                                                                                    <ListBox.ItemTemplate>
                                                                                                                        <DataTemplate>
                                                                                                                            <CheckBox Content="{l:GameBinding Path=Display, KindPath=Kind}" Visibility="{l:GameBinding Path=Display, KindPath=Kind, Visibility=True}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" Style="{StaticResource FilterPillCheckBox}" Margin="0,0,7,7" ToolTip="{l:Loc Key='锁定项是 Unit 身份标签，避免误删'}" />
                                                                                                                        </DataTemplate>
                                                                                                                    </ListBox.ItemTemplate>
                                                                                                                </ListBox>
                                                                                                            </DockPanel>
                                                                                                        </Border>
                                                                                                    </Popup>
                                                                                                    <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                                                                             Visibility="{Binding DataContext.AdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                                             ToolTip="{l:Loc Key='专业模式可直接编辑自定义标签；使用英文逗号分隔'}" />
                                                                                                </StackPanel>
                                                                                            </Grid><TextBlock Text="{l:Loc Key='四向类型不同，请选择统一类型'}" Visibility="{Binding ShowMixedArmor, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10" TextWrapping="Wrap"/><StackPanel Visibility="{Binding IsReconPresetEditor, Converter={StaticResource BooleanToVisibilityConverter}}"><ComboBox ItemsSource="{Binding ReconPresets}" SelectedIndex="-1" SelectionChanged="ReconPreset_SelectionChanged" ToolTip="{l:Loc Key=侦察显示评级门槛}" IsEnabled="{Binding IsEditable}"/>
                                                                                            <Expander Header="{l:Loc Key=档位参考}" IsExpanded="False"><TextBlock Text="{l:Loc Key='GDC 显示门槛：0 / 1768 / 2651 / 3535 / 5301 / 7068。原版常见组合（观察强度 / 识别率 / 周期秒）：1590 / 0.1 / 15；2473 / 0.2 / 12；3180 / 0.3 / 10；5300 / 0.5 / 6；7067 / 0.6 / 5；8834 / 0.75 / 4；侦察机特例 7500 / 1 / 2。仅作参考，选档不会修改识别率、周期或视野上限。'}" TextWrapping="Wrap" FontSize="10"/></Expander></StackPanel></StackPanel></controls:FieldRow><TextBlock Visibility="{Binding DataContext.AdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{l:LocalizedBinding Path=Hint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,7" MaxHeight="30" /><DockPanel Margin="0,6,0,0"><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
                                                                                                <Button Content="{l:Loc Key='撤销此项'}" DockPanel.Dock="Right" Padding="8,3" Style="{StaticResource SecondaryButton}" Visibility="{Binding HasDraft, Converter={StaticResource BooleanToVisibilityConverter}}" Click="UndoField_Click" />
                                                                                                <TextBlock Text="{l:LocalizedBinding Path=StatusText}" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                                            </DockPanel><TextBlock Text="{l:LocalizedBinding Path=ReadOnlyReason}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" ><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ReadOnlyReason}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Margin="0,8,0,0" Visibility="{Binding DataContext.AdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap"><Run Text="{l:Loc Key='字段：'}" /><Run Text="{Binding FieldPath, Mode=OneWay}" /></TextBlock>
                                                                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap"><Run Text="{l:Loc Key='位置：'}" /><Run Text="{Binding SourceLocation, Mode=OneWay}" /></TextBlock>
                                                                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap"><Run Text="{l:Loc Key='NDF 原值：'}" /><Run Text="{Binding RawValue, Mode=OneWay}" /></TextBlock>
                                                                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap"><Run Text="{l:Loc Key='草稿目标：'}" /><Run Text="{Binding TargetRaw, Mode=OneWay}" /></TextBlock>
                                                                                                <TextBlock Text="{Binding ConversionSource}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" />
                                                                                            </StackPanel></StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>





                                    </StackPanel>
                                </ScrollViewer>
                            </Border>



                            <Border x:Name="BatchUnitInspector" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Padding="12"
                                    Visibility="{Binding UnitWorkspace.HasBatchInspector, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Key='批量单位检查器'}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{l:Loc Key='只列出所有勾选 Unit 都具备的安全字段；输入本身不会创建草稿。'}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,9" />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel><Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{l:Loc Key='批量编辑'}" FontWeight="SemiBold" />
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0">
                                            <Run Text="{l:Loc Key='已勾选 '}" /><Run Text="{Binding UnitWorkspace.BatchSelectedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{l:Loc Key=' 个'}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,4">
                                    <WrapPanel>
                                        <StackPanel Width="155" Margin="0,0,10,8">
                                            <TextBlock Text="{l:Loc Key='目标范围'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding UnitWorkspace.BatchScopeOptions}" SelectedItem="{Binding UnitWorkspace.SelectedBatchScope}" ToolTip="{l:Loc Key='已勾选只处理复选框对象；当前筛选结果会处理表格中完整筛选集合'}" />
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,10,8">
                                            <TextBlock Text="{l:Loc Key='字段'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding UnitWorkspace.VisibleBatchFields}" SelectedItem="{Binding UnitWorkspace.SelectedBatchField}" DisplayMemberPath="DisplayName" ToolTip="{l:Loc Key='只列出当前项目至少一个 Unit 上可编辑的字段'}" />
                                        </StackPanel>
                                        <StackPanel Width="180" Margin="0,0,10,8">
                                            <TextBlock Text="{l:Loc Key='操作'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding UnitWorkspace.VisibleBatchOperations}" SelectedItem="{Binding UnitWorkspace.SelectedBatchOperation}" DisplayMemberPath="DisplayName" />
                                        </StackPanel>
                                        <Grid Margin="0,0,10,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                            <TextBlock Text="{l:LocalizedBinding Path=UnitWorkspace.BatchOperandHint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <Grid>
                                                <TextBox Text="{Binding UnitWorkspace.BatchOperand, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding UnitWorkspace.IsBatchTextEditor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ComboBox ItemsSource="{Binding UnitWorkspace.BatchValueChoices}"
                                                          SelectedItem="{Binding UnitWorkspace.BatchOperand, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding UnitWorkspace.IsBatchChoiceEditor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                            </StackPanel>
                                            <controls:ParameterNote Grid.Column="1" Text="{Binding UnitWorkspace.SelectedBatchField.OriginalParameter}" Margin="10,16,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Width="145" Margin="0,0,10,8" Visibility="{Binding UnitWorkspace.ShowsBatchFormulaOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{l:Loc Key='取整'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding UnitWorkspace.BatchRoundingOptions}" SelectedItem="{Binding UnitWorkspace.SelectedBatchRounding}" DisplayMemberPath="DisplayName" />
                                        </StackPanel>
                                        <StackPanel Width="115" Margin="0,0,10,8" Visibility="{Binding UnitWorkspace.ShowsBatchFormulaOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{l:Loc Key='最小值（可空）'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding UnitWorkspace.BatchMinimum, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="115" Margin="0,0,10,8" Visibility="{Binding UnitWorkspace.ShowsBatchFormulaOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{l:Loc Key='最大值（可空）'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding UnitWorkspace.BatchMaximum, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Content="{l:Loc Key='预览批量结果'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,0" IsEnabled="{Binding UnitWorkspace.CanPreviewBatch}" Click="PreviewBatch_Click" />
                                        <Button Content="{l:Loc Key='加入草稿'}" Style="{StaticResource PrimaryButton}" Padding="12,7" IsEnabled="{Binding UnitWorkspace.CanAddBatchDrafts}" Click="AddBatchDrafts_Click" ToolTip="{l:Loc Key='只写入 .warno-editor 草稿；正式文件仍需统一预览并应用'}" />
                                    </WrapPanel>

                                    <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,9,0,0"
                                            Visibility="{Binding UnitWorkspace.HasBatchPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding UnitWorkspace.BatchPreviewSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UnitWorkspace.BatchSamplesText}" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UnitWorkspace.BatchImpactText}" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,7,0,0"
                                            Visibility="{Binding UnitWorkspace.HasBatchMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding UnitWorkspace.BatchMessagesText}" TextWrapping="Wrap" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Expander><TextBlock Text="{l:Loc Key=共有字段}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,10"/><ItemsControl ItemsSource="{Binding UnitWorkspace.CommonBatchFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,7">
                                                        <StackPanel>
                                                            <TextBlock Text="{l:LocalizedBinding Path=Label}" FontWeight="SemiBold"/><TextBlock Text="{l:Loc Key=多种值}" Visibility="{Binding IsMixed, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,5"/>
                                                            <TextBlock Visibility="{Binding DataContext.AdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{l:LocalizedBinding Path=Hint}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,5" />
                                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsTextEditor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding EditValue}" Visibility="{Binding IsChoiceEditor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <controls:ParameterNote Grid.Column="1" Text="{Binding OriginalParameter}" Margin="10,0,0,0" VerticalAlignment="Center"/></Grid><DockPanel Margin="0,6,0,0">
                                                                <Button Content="{l:Loc Key='加入草稿'}" DockPanel.Dock="Right" Padding="8,4" Click="AddCommonBatchField_Click" IsEnabled="{Binding CanAddDraft}" />
                                                                <TextBlock Text="{l:LocalizedBinding Path=StatusText}" FontSize="9" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl></StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
</UserControl>
