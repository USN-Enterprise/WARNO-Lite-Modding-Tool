<Window x:Class="WarnoLiteModdingTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WarnoLiteModdingTool.App.Localisation"
        xmlns:workspaces="clr-namespace:WarnoLiteModdingTool.App.Workspaces"
        xmlns:controls="clr-namespace:WarnoLiteModdingTool.App.Controls"
        Title="WARNO Lite Modding Tool" Icon="/WarnoLiteModdingTool;component/Assets/App.ico"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Width="1420"
        Height="860"
        MinWidth="1200"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <DockPanel>
        <controls:WindowTitleBar DockPanel.Dock="Top" Height="40" />
    <Grid Background="{DynamicResource BackgroundBrush}" IsEnabled="{Binding CanInteract}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="3" Fill="{DynamicResource MainBackgroundBrush}" IsHitTestVisible="False"/>
        <Border x:Name="WelcomePanel" Grid.Row="1" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Padding="36" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasOpenProject}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsProblemModule}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel>
                <TextBlock Text="WARNO Lite Modding Tool" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{l:Loc Key=打开你的Mod，开始编辑}" FontSize="16" Margin="0,12,0,24" Foreground="{DynamicResource MutedTextBrush}"/>
                <Button Content="{l:Loc Key='打开 Mod 文件夹'}" Style="{StaticResource PrimaryButton}" Click="OpenProject_Click" IsEnabled="{Binding CanOpenProject}"/>
                <Button Content="{l:Loc Key='自动查找 Mod'}" Click="FindMods_Click" IsEnabled="{Binding CanOpenProject}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="290" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ProjectName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectPath}"/>
                    <TextBlock Text="1.9.3" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">


                    <TextBlock Visibility="Collapsed" Text="{l:Loc Key='主题'}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox x:Name="ThemeSelector" Visibility="Collapsed"
                              Width="92"
                              Margin="0,0,18,0"
                              SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem Content="{l:Loc Key='黑蓝'}" Tag="DarkBlue" />
                        <ComboBoxItem Content="{l:Loc Key='白蓝'}" Tag="LightBlue" />
                    </ComboBox>

                    <Button Content="{l:Loc Key='取消扫描'}"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="CancelScan_Click"
                            Margin="0,0,10,0" />
                    <Button Content="{l:LocalizedBinding Path=ProblemButtonText}"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenProblems_Click"
                            Padding="12,8"
                            Margin="0,0,10,0" />
                    <Grid Margin="0,0,10,0">
                        <ToggleButton x:Name="ModToolsButton"
                                      Content="{l:Loc Key='Mod 工具'}"
                                      IsChecked="{Binding IsModToolsOpen, Mode=TwoWay}" />
                        <Popup x:Name="ModToolsPopup"
                               PlacementTarget="{Binding ElementName=ModToolsButton}"
                               Placement="Bottom"
                               HorizontalOffset="-250"
                               VerticalOffset="5"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsModToolsOpen, Mode=TwoWay}">
                            <Border Width="380" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Key='Mod 项目与官方工具'}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:Loc Key='打开项目，或手动调用当前项目可用的官方流程；同一时间只运行一个流程。'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,10" />

                                    <Button Content="{l:Loc Key='自动查找 Mod'}" Click="FindMods_Click" IsEnabled="{Binding CanOpenProject}" Padding="12,8" Margin="0,0,0,8"/>
                                    <Button x:Name="ModToolsOpenProjectButton" Content="{l:Loc Key='打开 Mod 文件夹'}" Style="{StaticResource PrimaryButton}" Padding="12,8" IsEnabled="{Binding CanOpenProject}" Click="OpenProject_Click" />
                                    <TextBlock Text="{l:Loc Key='选择包含 GameData 的 Mod 根目录'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,3,0,8" />

                                    <Button Content="{l:Loc Key='创建新 Mod'}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding CanCreateMod}"
                            Click="CreateMod_Click"
                            Padding="12,8"
                            Margin="0,0,10,0" />
<Button Content="{l:Loc Key='启动开发模式'}" Style="{StaticResource SecondaryButton}" Padding="12,8" IsEnabled="{Binding CanRunDevMode}" Click="RunDevMode_Click" ToolTip="{l:LocalizedBinding Path=DevModeAvailability}" />
                                    <TextBlock Text="{l:LocalizedBinding Path=DevModeAvailability}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,3,0,8" />

                                    <Button Content="{l:Loc Key='上传 Mod'}" Style="{StaticResource SecondaryButton}" Padding="12,8" IsEnabled="{Binding CanRunUpload}" Click="RunUpload_Click" ToolTip="{l:LocalizedBinding Path=UploadAvailability}" />
                                    <TextBlock Text="{l:LocalizedBinding Path=UploadAvailability}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,3,0,8" />

                                    <TextBox Text="{Binding OfficialCommandOutput, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="190" VerticalScrollBarVisibility="Auto"
                                             Visibility="{Binding HasOfficialCommandOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button x:Name="TopDraftButton" Content="{l:Loc Key=草稿总览}" Click="OpenDrafts_Click" IsEnabled="{Binding HasOpenProject}" Margin="0,0,10,0"/>
                    <Button x:Name="TopGenerateButton"
                            Content="{l:Loc Key='生成 / 编译 Mod'}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanRunGenerate}"
                            Click="RunGenerate_Click"
                            ToolTip="{Binding GenerateAvailability}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProjectPaneColumn" Width="220" MinWidth="200" MaxWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="WorkspaceColumn" Width="*" MinWidth="680" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>




                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Margin="0,0,0,2" />

                    <DockPanel Grid.Row="3" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="{l:Loc Key='功能模块'}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                        <ListBox x:Name="ModuleList" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Modules}"
                                 SelectedItem="{Binding SelectedModule}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">

                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="{DynamicResource NavigationItemBrush}" CornerRadius="8" Padding="11,10" MinHeight="56">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Opacity="{Binding Opacity}" ToolTip="{l:LocalizedBinding Path=Summary}">
                                        <TextBlock Text="{l:LocalizedBinding Path=DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{l:LocalizedBinding Path=Summary}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{l:LocalizedBinding Path=StatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StatusText}" Value="可用"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Text="{l:Loc Key='最近项目'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding RecentProjects}"
                                  SelectedItem="{Binding SelectedRecentProject}"
                                  DisplayMemberPath="DisplayText"
                                  MaxDropDownHeight="220"
                                  Padding="6" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{l:Loc Key='打开'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="OpenRecent_Click" />
                            <Button Grid.Column="2" Content="{l:Loc Key='移除'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="RemoveRecent_Click" />
                        </Grid>
                    <Button Content="{l:Loc Key='引用工作台'}" Click="OpenAdvanced_Click" Visibility="{Binding AdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0" /><Button Content="{l:Loc Key='设置'}" Click="OpenSettings_Click" Margin="0,6,0,0" Padding="12,7" /><CheckBox x:Name="AdvancedModeCheckBox"
                              Content="{l:Loc Key='专业模式'}"
                              IsChecked="{Binding AdvancedMode}"
                              Checked="AdvancedMode_Changed"
                              Unchecked="AdvancedMode_Changed"
                              VerticalAlignment="Center"
                              Margin="0,10,0,0" /></StackPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="MainPaneSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" Margin="0,8" />

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,16,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:LocalizedBinding Path=SelectedModule.DisplayName}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsObjectModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='当前显示 '}" />
                                <Run Text="{Binding VisibleObjectCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 个顶层对象'}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsUnitModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='当前显示 '}" />
                                <Run Text="{Binding UnitWorkspace.VisibleUnitCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 个 Unit · 草稿 '}" />
                                <Run Text="{Binding UnitWorkspace.DraftCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 项'}" />
                            </TextBlock>
                            <TextBlock Text="{l:Loc Key='按 Unit 选择现有 Weapon/Ammo；局部修改自动生成最小隔离链'}"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsWeaponModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{l:Loc Key='直接选择 Ammo 修改本体字段；保存为全部引用作用域草稿'}"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsAmmoModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsDivisionModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='现有师 '}" /><Run Text="{Binding DivisionWorkspace.Divisions.Count, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 个 · 单位池与费用联动草稿'}" /><Run Text="{Binding DivisionWorkspace.CompatibilitySummary, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsDraftModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='当前项目全部未应用修改 · 共 '}" />
                                <Run Text="{Binding UnitWorkspace.DraftCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 项'}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsProblemModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='Mod 问题 '}" /><Run Text="{Binding ModProblemCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 项 · 工具问题 '}" /><Run Text="{Binding ToolProblemCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{l:Loc Key=' 项'}" />
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Column="1"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsObjectModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox x:Name="ObjectSearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{l:Loc Key='搜索可读名称、内部描述符或类型'}"
                                     Padding="31,7,9,7" />
                            <TextBlock x:Name="ObjectSearchIcon"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="10,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Height="3"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ScanPercent, Mode=OneWay}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource ProgressTrackBrush}" />

                    <controls:RulesView Grid.Row="2" Workspace="{Binding RulesWorkspace}" Visibility="{Binding IsRulesModule, Converter={StaticResource BooleanToVisibilityConverter}}"><controls:RulesView.Style><Style TargetType="controls:RulesView"><Style.Triggers><DataTrigger Binding="{Binding UnitWorkspace.IsTransactionBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></controls:RulesView.Style></controls:RulesView>
                    <controls:StrategicWorkspaceView Grid.Row="2" DataContext="{Binding StrategicWorkspace}" Visibility="{Binding DataContext.IsStrategicModule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <workspaces:UnitWorkspaceView x:Name="UnitPage" Grid.Row="2" Visibility="{Binding IsUnitModule, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <workspaces:WeaponWorkspaceView x:Name="WeaponPage" Grid.Row="2" Visibility="{Binding IsWeaponModule, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <workspaces:AmmoWorkspaceView x:Name="AmmoPage" Grid.Row="2" Visibility="{Binding IsAmmoModule, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <workspaces:DivisionWorkspaceView x:Name="DivisionPage" Grid.Row="2" Visibility="{Binding IsDivisionModule, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <workspaces:DraftWorkspaceView x:Name="DraftPage" Grid.Row="2" Visibility="{Binding IsDraftModule, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <workspaces:ProblemWorkspaceView x:Name="ProblemPage" Grid.Row="2" Visibility="{Binding IsProblemModule, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <workspaces:ObjectWorkspaceView x:Name="ObjectPage" Grid.Row="2" Visibility="{Binding IsObjectModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,9">
            <DockPanel>
                <TextBlock Text="{l:LocalizedBinding Path=StatusText}" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="{Binding ProjectPath}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="760" />
            </DockPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
