                                                    </DockPanel>
                                                    <TextBlock Text="{l:LocalizedBinding Path=Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header><TextBlock><Run Text="{l:Loc Key='工具问题（'}" /><Run Text="{Binding ToolProblemCount, Mode=OneWay}" /><Run Text="）" /></TextBlock></TabItem.Header>
                                <ListBox SelectionMode="Extended" x:Name="ToolProblemList" ItemsSource="{Binding ToolProblems}" SelectedItem="{Binding SelectedProblem}" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,9">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{l:LocalizedBinding Path=Title}" FontWeight="SemiBold" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SeverityText}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="10" />
                                                    </DockPanel>
                                                    <TextBlock Text="{l:LocalizedBinding Path=Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        <TabItem Header="{l:Loc Key=已忽略}"><ListBox x:Name="IgnoredProblemList" SelectionMode="Extended" ItemsSource="{Binding IgnoredProblems}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedProblem}"/></TabItem></TabControl></DockPanel>

                        <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Key='诊断详情'}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedProblem.Title, TargetNullValue=请选择一条问题}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedProblem.Id, StringFormat=错误编号：{0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedProblem.Location, StringFormat=位置：{0}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding SelectedProblem.DiagnosticText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="{l:Loc Key='复制诊断'}" Style="{StaticResource PrimaryButton}" Padding="12,7" Click="CopyProblem_Click" />
                                    <Button Content="{l:Loc Key='打开日志目录'}" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0" Click="OpenProblemLogs_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2"
                          Visibility="{Binding IsObjectModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,7">
                            <DockPanel>
                                <TextBlock Text="{l:Loc Key='点击表头可切换排序'}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                <TextBlock x:Name="ObjectSortLabel" Text="{l:Loc Key='排序：源文件 ↑ · 行号 ↑'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ObjectListColumn" Width="*" MinWidth="480" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition x:Name="ObjectDetailColumn" Width="0" MinWidth="0" MaxWidth="620" />
                            </Grid.ColumnDefinitions>

                            <DataGrid x:Name="ObjectIndexGrid"
                                      Grid.Column="0"
                                      ItemsSource="{Binding ObjectsView}"
                                      SelectedItem="{Binding SelectedObject}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="True"
                                      Sorting="ObjectIndex_Sorting"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                      BorderThickness="0"
                                      RowHeaderWidth="0"
                                      RowHeight="38"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:Loc Key='名称'}"
                                                        Binding="{Binding DisplayName}"
                                                        SortMemberPath="DisplayName"
                                                        ElementStyle="{StaticResource IndexPrimaryGridText}"
                                                        HeaderStyle="{StaticResource IndexGridColumnHeader}"
                                                        Width="2*" />
                                    <DataGridTextColumn Header="{l:Loc Key='内部类型'}"
                                                        Binding="{Binding TypeName}"
                                                        SortMemberPath="TypeName"
                                                        ElementStyle="{StaticResource SecondaryGridText}"
                                                        Width="1.25*" />
                                    <DataGridTextColumn Header="{l:Loc Key='源文件'}"
                                                        Binding="{Binding RelativeSourceFile}"
                                                        SortMemberPath="RelativeSourceFile"
                                                        ElementStyle="{StaticResource SecondaryGridText}"
                                                        Width="2.3*" />
                                    <DataGridTextColumn Header="{l:Loc Key='行号'}"
                                                        Binding="{Binding LineNumber}"
                                                        SortMemberPath="LineNumber"
                                                        ElementStyle="{StaticResource SecondaryGridText}"
                                                        Width="72" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <GridSplitter x:Name="ObjectDetailSplitter"
                                          Grid.Column="1"
                                          Style="{StaticResource PaneSplitter}"
                                          Visibility="{Binding AdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Border Grid.Column="2"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    Padding="16"
                                    Visibility="{Binding AdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Key='高级详情'}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{l:Loc Key='选中对象'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,14,0,4" />
                                        <TextBlock Text="{Binding SelectedObject.Name, TargetNullValue=尚未选择对象}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedObject.TypeName}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />

                                        <TextBlock Text="{l:Loc Key='源文件'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,14,0,4" />
                                        <TextBlock Text="{Binding SelectedObject.SourceFile, TargetNullValue=—}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="10">
                                            <Run Text="{l:Loc Key='行 '}" /><Run Text="{Binding SelectedObject.LineNumber, TargetNullValue=—, Mode=OneWay}" />
                                            <Run Text="{l:Loc Key=' · 字符偏移 '}" /><Run Text="{Binding SelectedObject.CharacterOffset, TargetNullValue=—, Mode=OneWay}" />
                                            <Run Text="{l:Loc Key=' · 字节偏移 '}" /><Run Text="{Binding SelectedObject.ByteOffset, TargetNullValue=—, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Text="{l:Loc Key='项目诊断'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,18,0,7" />
                                        <ItemsControl ItemsSource="{Binding Diagnostics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,7">
                                                        <StackPanel>
                                                            <TextBlock Text="{l:LocalizedBinding Path=Title}" FontWeight="SemiBold" FontSize="12" />
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,9">
            <DockPanel>
                <TextBlock Text="{l:LocalizedBinding Path=StatusText}" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="{Binding ProjectPath}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="760" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
