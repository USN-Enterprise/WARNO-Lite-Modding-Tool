                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{l:Loc Key='允许的运输 Unit'}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" /><controls:ParameterNote Text="AvailableTransportList"/>
