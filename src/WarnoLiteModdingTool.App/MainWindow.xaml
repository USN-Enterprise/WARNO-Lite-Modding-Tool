<Window x:Class="WarnoLiteModdingTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WarnoLiteModdingTool.App.Localisation"
        xmlns:controls="clr-namespace:WarnoLiteModdingTool.App.Controls"
        Title="WARNO Lite Modding Tool" Icon="/WarnoLiteModdingTool;component/Assets/App.ico"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Width="1420"
        Height="860"
        MinWidth="1200"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="3" Fill="{DynamicResource MainBackgroundBrush}" IsHitTestVisible="False"/>
        <Button Grid.Row="1" Panel.ZIndex="10" Content="{l:Loc Key='自动查找 Mod'}" Click="FindMods_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,16"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasOpenProject}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="W" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="WARNO Lite Modding Tool" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{l:Loc Key='1.8.5 · 单位简化与游戏规则'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{l:Loc Key='引用工作台'}" Click="OpenAdvanced_Click" Visibility="{Binding AdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,10,0" />
                    <Button Content="{l:Loc Key='设置'}" Click="OpenSettings_Click" Margin="0,0,12,0" Padding="12,7" />
                    <TextBlock Visibility="Collapsed" Text="{l:Loc Key='主题'}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox x:Name="ThemeSelector" Visibility="Collapsed"
                              Width="92"
                              Margin="0,0,18,0"
                              SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem Content="{l:Loc Key='黑蓝'}" Tag="DarkBlue" />
                        <ComboBoxItem Content="{l:Loc Key='白蓝'}" Tag="LightBlue" />
                    </ComboBox>
                    <CheckBox x:Name="AdvancedModeCheckBox"
                              Content="{l:Loc Key='专业模式'}"
                              IsChecked="{Binding AdvancedMode}"
                              Checked="AdvancedMode_Changed"
                              Unchecked="AdvancedMode_Changed"
                              VerticalAlignment="Center"
                              Margin="0,0,18,0" />
                    <Button Content="{l:Loc Key='取消扫描'}"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="CancelScan_Click"
                            Margin="0,0,10,0" />
                    <Button Content="{l:LocalizedBinding Path=ProblemButtonText}"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenProblems_Click"
                            Padding="12,8"
                            Margin="0,0,10,0" />
                    <Grid Margin="0,0,10,0">
                        <ToggleButton x:Name="ModToolsButton"
                                      Content="{l:Loc Key='Mod 工具'}"
                                      IsChecked="{Binding IsModToolsOpen, Mode=TwoWay}" />
                        <Popup x:Name="ModToolsPopup"
                               PlacementTarget="{Binding ElementName=ModToolsButton}"
                               Placement="Bottom"
                               HorizontalOffset="-250"
                               VerticalOffset="5"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsModToolsOpen, Mode=TwoWay}">
                            <Border Width="380" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Key='Mod 项目与官方工具'}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:Loc Key='打开项目，或手动调用当前项目可用的官方流程；同一时间只运行一个流程。'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,10" />

                                    <Button Content="{l:Loc Key='自动查找 Mod'}" Click="FindMods_Click" IsEnabled="{Binding CanOpenProject}" Padding="12,8" Margin="0,0,0,8"/>
                                    <Button x:Name="ModToolsOpenProjectButton" Content="{l:Loc Key='打开 Mod 文件夹'}" Style="{StaticResource PrimaryButton}" Padding="12,8" IsEnabled="{Binding CanOpenProject}" Click="OpenProject_Click" />
                                    <TextBlock Text="{l:Loc Key='选择包含 GameData 的 Mod 根目录'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,3,0,8" />

                                    <Button Content="{l:Loc Key='启动开发模式'}" Style="{StaticResource SecondaryButton}" Padding="12,8" IsEnabled="{Binding CanRunDevMode}" Click="RunDevMode_Click" ToolTip="{l:LocalizedBinding Path=DevModeAvailability}" />
                                    <TextBlock Text="{l:LocalizedBinding Path=DevModeAvailability}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,3,0,8" />

                                    <Button Content="{l:Loc Key='上传 Mod'}" Style="{StaticResource SecondaryButton}" Padding="12,8" IsEnabled="{Binding CanRunUpload}" Click="RunUpload_Click" ToolTip="{l:LocalizedBinding Path=UploadAvailability}" />
                                    <TextBlock Text="{l:LocalizedBinding Path=UploadAvailability}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,3,0,8" />

                                    <TextBox Text="{Binding OfficialCommandOutput, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="190" VerticalScrollBarVisibility="Auto"
                                             Visibility="{Binding HasOfficialCommandOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Content="{l:Loc Key='创建新 Mod'}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding CanCreateMod}"
                            Click="CreateMod_Click"
                            Padding="12,8"
                            Margin="0,0,10,0" />
                    <Button x:Name="TopGenerateButton"
                            Content="{l:Loc Key='生成 / 编译 Mod'}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanRunGenerate}"
                            Click="RunGenerate_Click"
                            ToolTip="{Binding GenerateAvailability}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProjectPaneColumn" Width="272" MinWidth="220" MaxWidth="440" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="WorkspaceColumn" Width="*" MinWidth="680" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{l:Loc Key='项目'}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Grid.Row="1" Margin="0,8,0,14">
                        <TextBlock Text="{Binding ProjectName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{l:LocalizedBinding Path=ProjectSummary}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12" />

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="{l:Loc Key='功能模块'}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                        <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Modules}"
                                 SelectedItem="{Binding SelectedModule}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">

                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="{DynamicResource NavigationItemBrush}" CornerRadius="6" Padding="11,9">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Opacity="{Binding Opacity}">
                                        <DockPanel>
                                            <TextBlock Text="{l:LocalizedBinding Path=StatusText}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="8,0,0,0" />
                                            <TextBlock Text="{l:LocalizedBinding Path=DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{l:LocalizedBinding Path=Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Text="{l:Loc Key='最近项目'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding RecentProjects}"
                                  SelectedItem="{Binding SelectedRecentProject}"
                                  DisplayMemberPath="DisplayText"
                                  MaxDropDownHeight="220"
                                  Padding="6" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{l:Loc Key='打开'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="OpenRecent_Click" />
                            <Button Grid.Column="2" Content="{l:Loc Key='移除记录'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="RemoveRecent_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="MainPaneSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" Margin="0,8" />

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,16,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:LocalizedBinding Path=SelectedModule.DisplayName}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsObjectModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='当前显示 '}" />
                                <Run Text="{Binding VisibleObjectCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 个顶层对象'}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsUnitModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='当前显示 '}" />
                                <Run Text="{Binding UnitWorkspace.VisibleUnitCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 个 Unit · 草稿 '}" />
                                <Run Text="{Binding UnitWorkspace.DraftCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 项'}" />
                            </TextBlock>
                            <TextBlock Text="{l:Loc Key='按 Unit 选择现有 Weapon/Ammo；局部修改自动生成最小隔离链'}"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsWeaponModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{l:Loc Key='直接选择 Ammo 修改本体字段；保存为全部引用作用域草稿'}"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsAmmoModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsDivisionModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='现有师 '}" /><Run Text="{Binding DivisionWorkspace.Divisions.Count, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 个 · 单位池与费用联动草稿'}" /><Run Text="{Binding DivisionWorkspace.CompatibilitySummary, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsDraftModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='当前项目全部未应用修改 · 共 '}" />
                                <Run Text="{Binding UnitWorkspace.DraftCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 项'}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding IsProblemModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{l:Loc Key='Mod 问题 '}" /><Run Text="{Binding ModProblemCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{l:Loc Key=' 项 · 工具问题 '}" /><Run Text="{Binding ToolProblemCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{l:Loc Key=' 项'}" />
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Column="1"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsObjectModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox x:Name="ObjectSearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{l:Loc Key='搜索可读名称、内部描述符或类型'}"
                                     Padding="31,7,9,7" />
                            <TextBlock x:Name="ObjectSearchIcon"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="10,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Height="3"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ScanPercent, Mode=OneWay}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource ProgressTrackBrush}" />

                    <controls:RulesView Grid.Row="2" Workspace="{Binding RulesWorkspace}" Visibility="{Binding IsRulesModule, Converter={StaticResource BooleanToVisibilityConverter}}"><controls:RulesView.Style><Style TargetType="controls:RulesView"><Style.Triggers><DataTrigger Binding="{Binding UnitWorkspace.IsTransactionBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></controls:RulesView.Style></controls:RulesView>
                    <controls:StrategicWorkspaceView Grid.Row="2" DataContext="{Binding StrategicWorkspace}" Visibility="{Binding DataContext.IsStrategicModule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid Grid.Row="2" Visibility="{Binding IsUnitModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid x:Name="UnitFilterPanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox x:Name="UnitSearchBox" Text="{Binding UnitWorkspace.TextFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc Key='搜索名称或内部描述符'}" Padding="29,6,9,6" />
                                    <TextBlock x:Name="UnitSearchIcon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>

                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                    <ItemsControl x:Name="UnitActiveFilterTags" ItemsSource="{Binding UnitWorkspace.ActiveFilterTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="13" Padding="9,4,4,4" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" FontSize="11" />
                                                        <Button Content="×" Style="{StaticResource SecondaryButton}" Padding="5,0" Margin="5,0,0,0" MinWidth="20" Click="RemoveFilterTag_Click" ToolTip="{l:Loc Key='移除此筛选'}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Grid.Column="3" Content="{l:Loc Key='清空'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="ClearUnitFilters_Click"
                                        Visibility="{Binding UnitWorkspace.HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <ToggleButton x:Name="UnitFilterButton" Grid.Column="5" MinWidth="92" MinHeight="36" Padding="16,9" IsChecked="{Binding UnitWorkspace.IsFilterPanelOpen, Mode=TwoWay}">
                                    <TextBlock>
                                        <Run Text="{l:Loc Key='筛选 '}" /><Run Text="{Binding UnitWorkspace.ActiveFilterCount, Mode=OneWay}" />
                                    </TextBlock>
                                </ToggleButton>

                                <Popup x:Name="UnitFilterPopup"
                                       PlacementTarget="{Binding ElementName=UnitFilterButton}"
                                       Placement="Bottom"
                                       HorizontalOffset="-690"
                                       VerticalOffset="5"
                                       AllowsTransparency="True"
                                       StaysOpen="False"
                                       IsOpen="{Binding UnitWorkspace.IsFilterPanelOpen, Mode=TwoWay}">
                                    <Border Width="790" MaxHeight="540" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{l:Loc Key='组合筛选'}" FontSize="16" FontWeight="SemiBold" />
                                                    <ComboBox DockPanel.Dock="Right" Width="112" ItemsSource="{Binding UnitWorkspace.FilterMatchModes}" SelectedItem="{Binding UnitWorkspace.FilterMatchMode}" ToolTip="{l:Loc Key='全部条件：跨类别都满足；任一条件：任一类别命中'}" />
                                                </DockPanel>
                                                <TextBlock Text="{l:Loc Key='同类标签始终任选其一；文本搜索始终与筛选结果相交。'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,-7,0,10" />
                                                <ItemsControl ItemsSource="{Binding UnitWorkspace.FilterDimensions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,13">
                                                                <TextBlock Text="{l:LocalizedBinding Path=Label}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                                <StackPanel Orientation="Horizontal"><Button Content="{l:Loc Key='全选'}" Tag="True" Click="SelectFilterDimension_Click"/><Button Content="{l:Loc Key='取消全选'}" Tag="False" Click="SelectFilterDimension_Click"/></StackPanel><ItemsControl ItemsSource="{Binding Options}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox Content="{l:GameBinding Path=Value, KindPath=DimensionKey}" Visibility="{l:GameBinding Path=Value, KindPath=DimensionKey, Visibility=True}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource FilterPillCheckBox}" Margin="0,0,7,6" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,11,0,0">
                                                    <DockPanel>
                                                        <Button Content="{l:Loc Key='清空全部'}" Style="{StaticResource SecondaryButton}" Padding="11,6" Click="ClearUnitFilters_Click" />
                                                        <Button Content="{l:Loc Key='收起'}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="CloseUnitFilters_Click" />
                                                    </DockPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button x:Name="UnitSelectAllButton" Content="{l:Loc Key='全选当前筛选'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="SelectVisibleBatch_Click" ToolTip="{l:Loc Key='把当前表格中的完整筛选结果加入勾选集合'}" />
                                        <Button x:Name="UnitClearSelectionButton" Content="{l:Loc Key='清空选择'}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="8,0,0,0" Click="ClearBatchSelection_Click" />
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="{l:Loc Key='批量选择 · 已选 '}" /><Run Text="{Binding UnitWorkspace.BatchSelectedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{l:Loc Key=' 个'}" />
                                    </TextBlock>
                                </DockPanel>
                            <StackPanel Orientation="Horizontal"><Button Content="{l:Loc Key=新增单位}" Click="CreateUnit_Click"/><Button Content="{l:Loc Key=编辑创建设置}" Tag="edit" Click="CreateUnit_Click"/></StackPanel><Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{l:Loc Key='批量编辑'}" FontWeight="SemiBold" />
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="10,0,0,0">
                                            <Run Text="{l:Loc Key='已勾选 '}" /><Run Text="{Binding UnitWorkspace.BatchSelectedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{l:Loc Key=' 个'}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,4">
                                    <WrapPanel>
                                        <StackPanel Width="155" Margin="0,0,10,8">
                                            <TextBlock Text="{l:Loc Key='目标范围'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding UnitWorkspace.BatchScopeOptions}" SelectedItem="{Binding UnitWorkspace.SelectedBatchScope}" ToolTip="{l:Loc Key='已勾选只处理复选框对象；当前筛选结果会处理表格中完整筛选集合'}" />
                                        </StackPanel>
                                        <StackPanel Width="190" Margin="0,0,10,8">
