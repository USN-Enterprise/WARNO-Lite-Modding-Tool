                                    <TextBlock Text="{Binding SelectedDraft.Scope, StringFormat=作用域：{0}}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedDraft.ObjectName, StringFormat=对象：{0}}" TextWrapping="Wrap" Margin="0,3,0,0" />

