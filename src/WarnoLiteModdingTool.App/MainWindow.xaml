                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{l:Loc Key='展示顺序'}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" /><controls:ParameterNote Text="InterfaceOrder"/><TextBox Text="{Binding DivisionWorkspace.InterfaceOrder, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                                    <TextBlock Text="{l:Loc Key='师类型（单选）'}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" /><controls:ParameterNote Text="TypeToken"/>
                                                    <ItemsControl ItemsSource="{Binding DivisionWorkspace.DivisionTypeOptions}" Margin="0,4,0,4">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Padding="10,5" Margin="0,0,6,6" Click="SelectDivisionType_Click" /></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
