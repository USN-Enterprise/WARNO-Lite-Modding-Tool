                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="5,4">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{l:GameBinding Path=DisplayName, Kind=division}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
