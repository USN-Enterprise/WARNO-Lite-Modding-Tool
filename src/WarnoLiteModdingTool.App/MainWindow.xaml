                                                                <Border Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="12" Padding="7,3" Margin="0,0,5,5" ToolTip="{Binding Detail}">
