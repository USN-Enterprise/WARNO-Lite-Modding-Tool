                                <DataGrid.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander x:Name="BatchExpander" IsExpanded="False" Margin="4"><Expander.Header><StackPanel x:Name="BatchHeader" Orientation="Horizontal"><CheckBox IsThreeState="True" Click="DraftGroupSelect_Click" Loaded="DraftGroup_Loaded" Margin="0,0,8,0"/><TextBlock Text="{Binding Items[0].BatchSummary}" MaxWidth="540" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}"/></StackPanel></Expander.Header><ItemsPresenter Margin="20,0,0,0"/></Expander><ControlTemplate.Triggers><DataTrigger Binding="{Binding Items[0].Resolved.Operation.GroupId}" Value="{x:Null}"><Setter TargetName="BatchExpander" Property="IsExpanded" Value="True"/><Setter TargetName="BatchExpander" Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></DataGrid.GroupStyle>
                                <DataGrid.Columns><DataGridTemplateColumn Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="DraftSelection_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:Loc Key='修改内容'}" Binding="{l:LocalizedBinding Path=Summary}" ElementStyle="{StaticResource IndexPrimaryGridText}" HeaderStyle="{StaticResource IndexGridColumnHeader}" Width="3*" MinWidth="260" />
                                    <DataGridTextColumn Header="{l:Loc Key='模块'}" Binding="{l:LocalizedBinding Path=Module}" ElementStyle="{StaticResource SecondaryGridText}" Width="86" />
                                    <DataGridTextColumn Header="{l:Loc Key='状态'}" Binding="{Binding Status}" ElementStyle="{StaticResource SecondaryGridText}" Width="110" />
                                    <DataGridTextColumn Header="{l:Loc Key='源文件'}" Binding="{Binding File}" ElementStyle="{StaticResource SecondaryGridText}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

